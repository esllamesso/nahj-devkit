{
  "description": "nahj-devkit safety guard: blocks clearly destructive shell commands and asks before risky ones.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/safety-guard.js"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
